# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# Firebase Admin SDK / service account credentials — secret, never commit.
# google-services.json is safe to commit (no private keys), but the Admin SDK
# private-key JSON is what authorizes server-side access to the Firebase project.
*firebase-adminsdk*.json
*service-account*.json

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android
